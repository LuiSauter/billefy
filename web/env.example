# ==============================================================================
# Billefy Web Frontend (Next.js 15) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure your local Next.js environment:
#   cp env.example .env.local
# Or:
#   cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Backend API Endpoint
# ------------------------------------------------------------------------------
# URL of the ASP.NET Core Backend API.
# Development default in launchSettings.json: http://localhost:5267
# Docker / Kestrel default port: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5267

# ------------------------------------------------------------------------------
# 2. Google OAuth Client ID (Google Identity Services)
# ------------------------------------------------------------------------------
# Client ID obtained from the Google Cloud Console (APIs & Services > Credentials).
# Required to enable Google Sign-In and Google One Tap on the web client.
# Format: <number>-<hash>.apps.googleusercontent.com
# Authorized JavaScript Origins in Google Console: http://localhost:3000, http://127.0.0.1:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
