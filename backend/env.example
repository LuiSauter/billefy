# ==============================================================================
# Billefy Backend (.NET 10) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or configure these variables in your environment or
# appsettings.Development.json).
# In ASP.NET Core, nested JSON keys correspond to double underscores (__) in env vars.

# ------------------------------------------------------------------------------
# 1. Database Connection String (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: Host=<host>;Port=<port>;Database=<dbname>;Username=<user>;Password=<password>
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=billefy;Username=postgres;Password=postgrespassword

# ------------------------------------------------------------------------------
# 2. ASP.NET Core Runtime Settings
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. WhatsApp Messaging Gateway Provider
# ------------------------------------------------------------------------------
# Options:
#   - "Devhooh"    : Sends via Devhooh API (https://api-whp.devhooh.com)
#   - "Meta"       : Sends via Meta Official WhatsApp Business Cloud API
#   - "Simulated"  : In-memory simulation (default fallback for development/tests)
WhatsApp__Provider=Devhooh

# Option A: Devhooh WhatsApp API Configuration
WhatsApp__Devhooh__BaseUrl=https://api-whp.devhooh.com
WhatsApp__Devhooh__ApiKey=wasa_live_TU_API_KEY_AQUI

# Option B: Meta Official WhatsApp Business Cloud API Configuration
WhatsApp__Meta__ApiVersion=v21.0
WhatsApp__Meta__PhoneNumberId=TU_META_PHONE_NUMBER_ID
WhatsApp__Meta__AccessToken=TU_META_ACCESS_TOKEN

# ------------------------------------------------------------------------------
# 4. Exchange Rate Provider (Parallel Market - DolarApi Binance P2P)
# ------------------------------------------------------------------------------
Fx__RateSourceUrl=https://bo.dolarapi.com/v1/dolares/binance

# ------------------------------------------------------------------------------
# 5. Binance Read-Only Credentials (Optional)
# Rule 18: Keys with trading or withdrawal permissions are strictly rejected.
# ------------------------------------------------------------------------------
Binance__ApiKey=TU_BINANCE_READ_ONLY_API_KEY
Binance__ApiSecret=TU_BINANCE_API_SECRET
