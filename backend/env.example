# ==============================================================================
# Billefy Backend (.NET 10) - Plantilla Exhaustiva de Variables de Entorno
# ==============================================================================
# Copiá este archivo a tu .env o exportá estas variables en tu entorno local.
# El backend soporta tanto el formato nativo de ASP.NET Core con doble guion bajo (__)
# como el formato plano estándar de variables de entorno (UPPERCASE_SNAKE_CASE).

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL Local (DBngin / TablePlus / Nativo)
# ------------------------------------------------------------------------------
# Mapea a ConnectionStrings:PostgreSQL.
# Si estás en macOS con DBngin, la base de datos por defecto es 'billefy-db' con usuario 'postgres' y sin password:
DB_CONNECTION="postgres"
DB_HOST="localhost"
DB_PORT="5432"
DB_DATABASE="billefy-db"
DB_USERNAME="postgres"
DB_PASSWORD=""

# Alternativa en formato directo de cadena de conexión Npgsql / EF Core:
# ConnectionStrings__PostgreSQL="Host=localhost;Port=5432;Database=billefy-db;Username=postgres;Password="

# ------------------------------------------------------------------------------
# 2. Puerto del Servidor y URLs de Binding de Kestrel
# ------------------------------------------------------------------------------
# Define el protocolo, host y puerto en el que escucha el backend (por defecto: http://localhost:5267).
# Podés usar la variable nativa de ASP.NET Core o definir solo el número de puerto con PORT:
ASPNETCORE_URLS="http://localhost:5267"
PORT="5267"

# ------------------------------------------------------------------------------
# 3. Orígenes Permitidos por CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Lista de URLs separadas por coma permitidas para consumir la API desde el navegador (Next.js).
# Mapea a Cors:AllowedOrigins en appsettings.json.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 4. Entorno de Ejecución de ASP.NET Core
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT="Development"

# ------------------------------------------------------------------------------
# 5. Proveedor de Pasarela de WhatsApp (IMessagingGateway)
# ------------------------------------------------------------------------------
# Mapea a WhatsApp:Provider. Opciones: "Devhooh", "Meta", o "Simulated" (fallback en memoria).
WhatsApp__Provider="Devhooh"
# WHATSAPP_PROVIDER="Devhooh"

# --- Opción A: API Devhooh WhatsApp (https://api-whp.devhooh.com) ---
WhatsApp__Devhooh__BaseUrl="https://api-whp.devhooh.com"
WhatsApp__Devhooh__ApiKey="wasa_live_TU_API_KEY_AQUI"
# WHATSAPP_DEVHOOH_BASEURL="https://api-whp.devhooh.com"
# WHATSAPP_DEVHOOH_APIKEY="wasa_live_TU_API_KEY_AQUI"

# --- Opción B: API Oficial WhatsApp Cloud de Meta (graph.facebook.com) ---
WhatsApp__Meta__BaseUrl="https://graph.facebook.com"
WhatsApp__Meta__ApiVersion="v21.0"
WhatsApp__Meta__PhoneNumberId="TU_PHONE_NUMBER_ID"
WhatsApp__Meta__AccessToken="TU_ACCESS_TOKEN"
# WHATSAPP_META_BASEURL="https://graph.facebook.com"
# WHATSAPP_META_APIVERSION="v21.0"
# WHATSAPP_META_PHONENUMBERID="TU_PHONE_NUMBER_ID"
# WHATSAPP_META_ACCESSTOKEN="TU_ACCESS_TOKEN"

# ------------------------------------------------------------------------------
# 6. Fuente de Tipo de Cambio Paralelo (DolarApi Binance P2P)
# ------------------------------------------------------------------------------
# Mapea a Fx:RateSourceUrl. Consume el mercado paralelo para BOB/USD (Regla 19).
Fx__RateSourceUrl="https://bo.dolarapi.com/v1/dolares/binance"
# FX_RATESOURCEURL="https://bo.dolarapi.com/v1/dolares/binance"

# ------------------------------------------------------------------------------
# 7. Credenciales Opcionales de Binance (Solo Lectura)
# ------------------------------------------------------------------------------
# Regla 18: Se rechaza cualquier clave con permisos de trading o retiro activados.
Binance__ApiKey="TU_BINANCE_API_KEY"
Binance__ApiSecret="TU_BINANCE_API_SECRET"
# BINANCE_APIKEY="TU_BINANCE_API_KEY"
# BINANCE_APISECRET="TU_BINANCE_API_SECRET"

# ------------------------------------------------------------------------------
# 8. Autenticación JWT e Identidad (AUTH-01 a AUTH-07)
# ------------------------------------------------------------------------------
Jwt__Secret="billefy_super_secret_jwt_signing_key_2026_at_least_32_bytes_long!"
Jwt__Issuer="BillefyApi"
Jwt__Audience="BillefyClients"
Jwt__ExpirationMinutes="60"
# JWT_SECRET="billefy_super_secret_jwt_signing_key_2026_at_least_32_bytes_long!"
