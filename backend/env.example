# ==============================================================================
# Billefy Backend (.NET 10) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or configure these variables in your environment or
# appsettings.Development.json).

# ------------------------------------------------------------------------------
# 1. Database Connection (Local PostgreSQL / DBngin / TablePlus)
# ------------------------------------------------------------------------------
# Default local setup for DBngin: host=localhost, port=5432, user=postgres, password="", db=billefy-db
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=billefy-db
DB_USERNAME=postgres
DB_PASSWORD=

# Alternative ASP.NET Core direct connection string format:
# ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=billefy-db;Username=postgres;Password=

# ------------------------------------------------------------------------------
# 2. Server Port & Hosting URLs
# ------------------------------------------------------------------------------
# Define the listening address and port for the API (default: http://localhost:5267)
ASPNETCORE_URLS=http://localhost:5267
# Or simply define a single port number:
# PORT=5267

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# ------------------------------------------------------------------------------
# Frontends that are allowed to make cross-origin requests to this API:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. ASP.NET Core Runtime Environment
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# 5. WhatsApp Messaging Gateway Provider
# ------------------------------------------------------------------------------
# Options:
#   - "Devhooh"    : Sends via Devhooh API (https://api-whp.devhooh.com)
#   - "Meta"       : Sends via Meta Official WhatsApp Business Cloud API
#   - "Simulated"  : In-memory simulation (default fallback for development/tests)
WhatsApp__Provider=Devhooh

# Option A: Devhooh WhatsApp API Configuration
WhatsApp__Devhooh__BaseUrl=https://api-whp.devhooh.com
WhatsApp__Devhooh__ApiKey=wasa_live_TU_API_KEY_AQUI

# Option B: Meta Official WhatsApp Business Cloud API Configuration
WhatsApp__Meta__ApiVersion=v21.0
WhatsApp__Meta__PhoneNumberId=TU_META_PHONE_NUMBER_ID
WhatsApp__Meta__AccessToken=TU_META_ACCESS_TOKEN

# ------------------------------------------------------------------------------
# 6. Exchange Rate Provider (Parallel Market - DolarApi Binance P2P)
# ------------------------------------------------------------------------------
Fx__RateSourceUrl=https://bo.dolarapi.com/v1/dolares/binance

# ------------------------------------------------------------------------------
# 7. Binance Read-Only Credentials (Optional)
# Rule 18: Keys with trading or withdrawal permissions are strictly rejected.
# ------------------------------------------------------------------------------
Binance__ApiKey=TU_BINANCE_READ_ONLY_API_KEY
Binance__ApiSecret=TU_BINANCE_API_SECRET
