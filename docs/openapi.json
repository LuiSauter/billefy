  "components": {
    "schemas": {
      "AccountDto": {
        "required": [
          "id",
          "name",
          "type",
          "currency",
          "balance",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "balance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccountType": {
        "type": "integer"
      },
      "ConfirmDraftRequest": {
        "required": [
          "accountId"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateAccountRequest": {
        "required": [
          "name",
          "type",
          "currency"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currency": {
            "type": "string"
          },
          "initialBalance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double",
            "default": 0
          }
        }
      },
      "CreateRawEventRequest": {
        "required": [
          "eventId",
          "channel",
          "sourceId",
          "maskedText"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string"
          },
          "sourceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "maskedText": {
            "type": [
              "null",
              "string"
            ]
          },
          "receivedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "DraftDto": {
        "required": [
          "id",
          "source",
          "status",
          "direction",
          "amount",
          "currency",
          "estimatedDate",
          "reference",
          "fingerprint",
          "confidence",
          "suggestedAccountId",
          "suggestedCategoryId",
          "confirmedAccountId",
          "confirmedCategoryId",
          "ledgerTransactionId",
          "createdAt",
          "confirmedAt",
          "discardedAt",
          "linkedEventsCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "estimatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": [
              "null",
              "string"
            ]
          },
          "fingerprint": {
            "type": "string"
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "suggestedAccountId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "suggestedCategoryId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "confirmedAccountId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "confirmedCategoryId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "ledgerTransactionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "discardedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "linkedEventsCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ImportStatementCsvRequest": {
        "required": [
          "accountId",
          "fileName",
          "csvContent",
          "currency"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "csvContent": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RateSnapshotDto": {
        "required": [
          "appliedRate",
          "rateSource",
          "fetchedAt",
          "isStale"
        ],
        "type": "object",
        "properties": {
          "appliedRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "rateSource": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isStale": {
            "type": "boolean"
          }
        }
      },
      "ReconcileAccountRequest": {
        "required": [
          "realBalance"
        ],
        "type": "object",
        "properties": {
          "realBalance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
