# ==============================================================================
# Billefy - Environment Variables Template
# Copy this file to .env and fill in your confidential secrets.
# ==============================================================================

# Database (PostgreSQL)
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=billefy;Username=billefy_user;Password=billefy_secret

# ASP.NET Core Host
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# WhatsApp Integration Gateway
# Options: "Devhooh", "Meta", or "Simulated"
WhatsApp__Provider=Devhooh

# Devhooh WhatsApp API Configuration (https://api-whp.devhooh.com)
WhatsApp__Devhooh__BaseUrl=https://api-whp.devhooh.com
WhatsApp__Devhooh__ApiKey=wasa_live_TU_API_KEY_AQUI

# Meta Official WhatsApp Business Cloud API Configuration
WhatsApp__Meta__ApiVersion=v21.0
WhatsApp__Meta__PhoneNumberId=TU_META_PHONE_NUMBER_ID
WhatsApp__Meta__AccessToken=TU_META_ACCESS_TOKEN

# Binance Read-Only Integration
# Note: Keys with trading or withdrawal permissions are strictly rejected (Rule 18)
Binance__ApiKey=TU_BINANCE_READ_ONLY_API_KEY
Binance__ApiSecret=TU_BINANCE_API_SECRET

# Parallel FX Rates Source (DolarApi Binance P2P)
Fx__RateSourceUrl=https://bo.dolarapi.com/v1/dolares/binance

# Web Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:5000
